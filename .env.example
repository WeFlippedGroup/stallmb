# =============================================================================
# StallMB – miljövariabler
# Kopiera till .env och fyll i värden:  cp .env.example .env
# =============================================================================

# --- App ---
NODE_ENV=production
APP_PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Postgres (Prisma) ---
# I Docker Compose pekar appen automatiskt på tjänsten "postgres".
# För lokal `npm run dev` ska host vara localhost.
POSTGRES_USER=stallmb
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=stallmb
POSTGRES_PORT=5432
DATABASE_URL=postgresql://stallmb:change-me-strong-password@localhost:5432/stallmb?schema=public

# --- MinIO (S3-kompatibel storage, ersätter Supabase Storage) ---
# Inte inkopplat i appen ännu – buckets skapas av minio-init.
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET_HORSES=horse-images
MINIO_BUCKET_ASSETS=site-assets

# --- Admin (tänkt ersättning för Supabase Auth – inte inkopplat ännu) ---
ADMIN_EMAIL=info@stallmb.com
ADMIN_PASSWORD=change-me

# --- Befintliga integrationer ---
HASTANNONS_API_KEY=

# --- Övergång från Vercel/Supabase ---
# Behövs tills admin (auth, storage, CRUD) migrerats bort från supabase-js.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Valfritt / oanvänt i koden idag ---
# resend finns i package.json men används inte.
RESEND_API_KEY=
