# =============================================================================
# StallMB – miljövariabler
# Kopiera till .env och fyll i värden:  cp .env.example .env
# =============================================================================

# --- App ---
NODE_ENV=production
APP_PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Postgres (Prisma) ---
# I Docker Compose pekar appen automatiskt på tjänsten "postgres".
# För lokal `npm run dev` ska host vara localhost.
POSTGRES_USER=stallmb
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=stallmb
POSTGRES_PORT=5432
DATABASE_URL=postgresql://stallmb:change-me-strong-password@localhost:5432/stallmb?schema=public

# --- Admin (cookie-session) ---
ADMIN_EMAIL=info@stallmb.com
ADMIN_PASSWORD=change-me
# Valfri egen nyckel för sessionscookien. Annars används ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# --- Befintliga integrationer ---
HASTANNONS_API_KEY=

# --- Valfritt / oanvänt i koden idag ---
# resend finns i package.json men används inte.
RESEND_API_KEY=
